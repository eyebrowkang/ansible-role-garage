---
profile: production

exclude_paths:
  - .ansible/
  - .venv/
  - .copier-answers.yml
  # ansible-test writes junit/coverage artefacts here; they otherwise trip a local
  # `make lint` run that follows `make sanity`/`units`.
  - tests/output/

# Several task names interpolate vars (e.g. the target Garage version); the
# production profile's name[template] rule would otherwise flag them.
skip_list:
  - name[template]
